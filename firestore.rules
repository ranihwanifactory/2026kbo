rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    // --- Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }
    
    // --- Visitor Tracking ---
    
    // IP logs for today
    match /daily_visits/{visitId} {
      // Only allow getting a specific log and creating a new one
      allow get: if true;
      allow create: if incoming().ip is string 
                   && incoming().timestamp == request.time;
    }
    
    // Global and daily stats
    match /stats/visitors {
      allow read: if true;
      // Allow incrementing (write) for counters
      allow write: if true; 
    }
    
    match /daily_stats/{date} {
      allow read: if true;
      allow write: if true;
    }
    
    // --- KBO Gallery ---
    
    match /posts/{postId} {
      // Anyone can see videos
      allow read: if true;
      
      // Creating a post: must be signed in and set themselves as the author
      allow create: if isSignedIn() 
                   && incoming().userId == request.auth.uid;
      
      // Updating/Deleting: must be the original author
      allow update, delete: if isSignedIn() 
                            && resource.data.userId == request.auth.uid;
    }
  }
}
